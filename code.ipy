import numpy as np
import pandas as pd
from collections import Counter
from sklearn.model_selection import train_test_split


data=pd.read_csv("data.csv")
X=data.drop(columns=["id","diagnosis"]).values
y=data["diagnosis"].values
X_train, X_test, y_train, y_test = train_test_split(X, y, random_state = 27, test_size = 0.2)


def euclidean_distance(X1, X2):
    return np.sqrt(np.sum((X1 - X2) ** 2))


class KNN:
    def __init__(self, k):
        self.k = k
        
    def fit(self, X, y):
        self.X_train = X
        self.y_train = y
    
    def predict(self, new_points):
        predictions = [self.predict_class(new_point) for new_point in new_points]
        return np.array(predictions)
    
    def predict_class(self, new_point):
        distances = [euclidean_distance(new_point, x_train) for x_train in self.X_train]
        k_indices = np.argsort(distances)[:self.k]
        k_nearest_labels = [self.y_train[i] for i in k_indices]
        most_common = Counter(k_nearest_labels).most_common(1)
        return most_common[0][0]
    
clf = KNN(5)
clf.fit(X_train, y_train)
prediction = clf.predict(X_test)
accuracy = np.mean(prediction == y_test)*100
print(f"Accuracy: {accuracy:.2f}%")

user_input = input("Enter patient details: ")
details = np.array(user_input.split(), dtype=int)
print(f"Model prediction: {clf.predict(details)}")
